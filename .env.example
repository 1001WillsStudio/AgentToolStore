# ────────────────────────────────────────────────────────────────────
# Agent ToolStore — Environment Variables
# Copy to .env and fill in your values.
# ────────────────────────────────────────────────────────────────────

# ── Server Authentication ─────────────────────────────────────────
# Secret key for JWT token signing (change in production!)
TOOLSTORE_SECRET_KEY=super-secret-key-change-this-in-production

# ── Server Database ───────────────────────────────────────────────
# System admin user password (set before first run)
TOOLSTORE_SYSTEM_PASSWORD=system_password_change_me

# ── Registry Publishing ───────────────────────────────────────────
# URL of the ToolStore registry server
TOOLSTORE_REGISTRY_URL=https://mrw33554432-agenttoolstore.hf.space
# Credentials for publishing toolsets (register at the registry server)
TOOLSTORE_REGISTRY_USER=pub_all
TOOLSTORE_REGISTRY_PASSWORD=all999

# ── ToolStore Client ──────────────────────────────────────────────
# Default toolset directories (colon-separated)
# TOOLSTORE_TOOLSET_DIRS=/path/to/extra/toolsets

# Default skill directories (colon-separated)
# TOOLSTORE_SKILL_DIRS=/path/to/extra/skills

# ── Logging ───────────────────────────────────────────────────────
# Set to DEBUG for verbose output
# LOG_LEVEL=INFO
